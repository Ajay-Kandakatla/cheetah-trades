#!/usr/bin/env bash
# .git/hooks/pre-commit (installed via `make install-hooks`).
#
# Purpose: stop silent drift in SEPA / Kell scoring formulas.
#
# If a commit touches any file under backend/sepa/, backend/options/,
# backend/setups/, or the contracts spec docs themselves, this hook
# runs the contracts regression tests inside the api container and
# blocks the commit if they fail.
#
# Why "blocks the commit" and not "warns": Ajay trades real money
# against these formulas. A silent score drift between commits is
# unacceptable — the contracts docs (docs/SEPA_CONTRACTS.md,
# docs/KELL_CONTRACTS.md) explicitly say so in §12.
#
# Override (NOT recommended): set CHEETAH_SKIP_CONTRACTS=1 in the
# environment. The hook prints a loud warning if it's bypassed, so
# the override is visible in the commit message author's terminal.
#
# How to install:
#     make install-hooks

set -e

CHANGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(backend/(sepa|options|setups|tests)/|docs/(SEPA|KELL)_CONTRACTS\.md|SPECS\.md|SPECS_VERIFIED\.md)' || true)

if [ -z "$CHANGED" ]; then
    # No trading-critical files touched — skip the contracts run.
    exit 0
fi

echo ""
echo "→ pre-commit: trading-critical files staged, running contracts regression tests…"
echo "  Files:"
echo "$CHANGED" | sed 's/^/    /'
echo ""

if [ "${CHEETAH_SKIP_CONTRACTS:-0}" = "1" ]; then
    echo "⚠  CHEETAH_SKIP_CONTRACTS=1 — bypassing contracts test. This is on YOU if a"
    echo "   formula drift sneaks into a commit. Document why in the commit message."
    exit 0
fi

# Run the contracts test. The api container must be up — if it isn't,
# tell the user how to bring it up instead of failing cryptically.
if ! docker compose ps --status running api 2>/dev/null | grep -q api; then
    echo "✗ api container is not running. Start it first:"
    echo "    docker compose up -d api"
    echo ""
    echo "Then retry the commit."
    exit 1
fi

if ! make contracts; then
    echo ""
    echo "✗ Contracts regression tests FAILED. Commit blocked."
    echo ""
    echo "If the formula change is intentional and reviewed:"
    echo "  1. Bump version in docs/SEPA_CONTRACTS.md or docs/KELL_CONTRACTS.md"
    echo "  2. Update the assertion in tests/test_*_contracts.py to match"
    echo "  3. Document the change in SPECS_VERIFIED.md"
    echo "  4. Retry the commit"
    echo ""
    echo "If this is an unintentional drift — REVERT the change first."
    exit 1
fi

echo "✓ Contracts regression tests passed. Commit allowed."
echo ""
